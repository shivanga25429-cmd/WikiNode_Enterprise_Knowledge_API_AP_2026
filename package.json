{
  "name": "wikinode-enterprise-knowledge-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WikiNode Phase 1: categories, articles, and keyword search with Express and PostgreSQL",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
